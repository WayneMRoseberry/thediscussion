<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PostgreSQL storage provider (EF Core + Npgsql). This is the only production project allowed to
    reference EF Core or Npgsql. Schema changes are made with EF Core migrations (Migrations/).
  -->
  <PropertyGroup>
    <RootNamespace>TheDiscussion.Storage.Postgres</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TheDiscussion.Core\TheDiscussion.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TheDiscussion.Storage.Tests" />
  </ItemGroup>
</Project>
